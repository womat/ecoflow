# systemd unit for ecoflowd, one instance per device.
#
#   sudo cp ecoflowd /usr/local/bin/
#   sudo cp contrib/ecoflowd@.service /etc/systemd/system/
#   sudo install -d -m 0700 /etc/ecoflowd
#   sudo install -m 0600 /dev/null /etc/ecoflowd/env
#   sudo systemctl enable --now ecoflowd@HC31XXXXXXXXXXXX
#
# The instance name after the @ is the serial number, so a second device is a
# second instance rather than a second unit file. Its readings need their own
# topic, because the serial travels in the payload rather than in the topic:
# put ECOFLOWD_OPTIONS with a different --topic into /etc/ecoflowd/<serial>.env,
# which is read after the shared file and overrides it.
#
# /etc/ecoflowd/env holds the credentials and the options, and must be readable
# by root alone:
#
#   ECOFLOW_EMAIL=someone@example.com
#   ECOFLOW_PASSWORD=...
#   MQTT_PASSWORD=...
#   ECOFLOWD_OPTIONS=--broker tcp://127.0.0.1:1883
#
# The password there is the EcoFlow account password, not an application token,
# and the login endpoint carries it base64-encoded rather than hashed. Anyone
# who can read that file has the account.
#
# The discharge block (--block, see the README) needs three more things: the
# token in the same file,
#
#   ECOFLOWD_HTTP_TOKEN=...        (openssl rand -hex 32)
#
# and a certificate and key, which the service user - a dynamic one - cannot
# read from /etc. systemd hands them over with LoadCredential=, and %d names
# the directory they appear in (systemd 248 or later). %d is not expanded
# inside $ECOFLOWD_OPTIONS, so the flags go on the command line itself, in a
# drop-in, /etc/systemd/system/ecoflowd@.service.d/block.conf:
#
#   [Service]
#   LoadCredential=tls.crt:/etc/ecoflowd/tls.crt
#   LoadCredential=tls.key:/etc/ecoflowd/tls.key
#   ExecStart=
#   ExecStart=/usr/local/bin/ecoflowd --sn %i $ECOFLOWD_OPTIONS --block \
#       --listen 172.17.0.1 --tls-cert %d/tls.crt --tls-key %d/tls.key
#
# 172.17.0.1 is Docker's default bridge, for a caller in a container; check it
# with "ip -4 addr show docker0", and put the same address in the certificate.
# If the bridge is not up yet when the service starts, binding fails and the
# service exits with 1 and restarts after RestartSec - no ordering needed.
# With ufw's default "deny incoming", containers time out until the port is
# allowed on the bridge, and only there:
#
#   sudo ufw allow in on docker0 to 172.17.0.1 port 8089 proto tcp

[Unit]
Description=EcoFlow PowerOcean %i to local MQTT
Documentation=https://github.com/womat/ecoflow
After=network-online.target
Wants=network-online.target

[Service]
Type=exec

# $ECOFLOWD_OPTIONS is unbraced on purpose: systemd splits it into separate
# arguments that way, which ${...} would not do.
ExecStart=/usr/local/bin/ecoflowd --sn %i $ECOFLOWD_OPTIONS

EnvironmentFile=/etc/ecoflowd/env
EnvironmentFile=-/etc/ecoflowd/%i.env

# No state on disk. The session token is held in memory for the life of the
# process, and the process outlives everything except a signal or rejected
# credentials - a network that comes and goes is handled internally. So the
# only thing persisting it would save is one login per reboot, which is not
# worth another copy of a credential on a filesystem.
Restart=on-failure
RestartSec=30

# 78 means the cloud rejected the credentials. Waiting fixes a network, never a
# typo, so restarting on it would only repeat a failed login for ever. It is
# kept narrow for that reason: a login that got no answer, or a 429 or 5xx, is
# an ordinary failure and restarts like any other.
RestartPreventExitStatus=78

DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
