# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# The commands, when built into the working directory. They have no extension,
# so the patterns above miss them, and "go build ./..." drops them right here.
/modbusread
/ecoflowd

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
# .vscode/

# EcoFlow's official Java demo client, downloaded for reference only.
# Third-party code with no license file - read it, don't vendor it.
ecoflow-open-demo/

# Claude Code's permission rules - per-user, not a team-wide convention.
.claude/settings.local.json
