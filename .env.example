# Copy to .env and fill in. .env holds the EcoFlow account password - keep it
# at chmod 600, it is the counterpart to /etc/ecoflowd/env under systemd.

# Serial number of the device, e.g. HC31XXXXXXXXXXXX
ECOFLOW_SN=

# The EcoFlow app account (not a developer key). The login endpoint carries the
# password base64-encoded, not hashed; only TLS protects it.
ECOFLOW_EMAIL=
ECOFLOW_PASSWORD=

# The local broker. host.docker.internal is the Docker host; for a broker in a
# container on a shared network, use its name, e.g. tcp://mosquitto:1883.
ECOFLOWD_BROKER=tcp://host.docker.internal:1883

# Only if the broker requires a login (with --mqtt-user in docker-compose.yaml).
# MQTT_PASSWORD=

# US accounts only.
# ECOFLOW_HOST=https://api-a.ecoflow.com

# Only with --listen (web page, --block): openssl rand -hex 32
# ECOFLOWD_HTTP_TOKEN=

# Pin an image version instead of latest, e.g. 0.8.0
# ECOFLOWD_VERSION=
